    @{
        ViewData["Title"] = "Tahakkuk ERP Admin Panel";
    }

    <div class="app-container">
        <div class="sidebar">
            <div class="sidebar-header">
                <h2><i class="fas fa-charging-station"></i> <span>Tahakkuk ERP</span></h2>
            </div>

            <div class="nav-menu">
                <div class="nav-item" data-module="cities"><i class="fas fa-city"></i><span>İller</span></div>
                <div class="nav-item" data-module="districts"><i class="fas fa-map-marker-alt"></i><span>İlçeler</span></div>
                <div class="nav-item" data-module="tahakkukYears"><i class="fas fa-calendar-alt"></i><span>Tahakkuk Yılları</span></div>
                <div class="nav-item" data-module="institutions"><i class="fas fa-building"></i><span>Kurumlar</span></div>
                <div class="nav-item" data-module="departments"><i class="fas fa-sitemap"></i><span>Daire Başkanlıkları</span></div>
                <div class="nav-item" data-module="directorates"><i class="fas fa-user-tie"></i><span>Müdürlükler</span></div>
                <div class="nav-item" data-module="scales"><i class="fas fa-ruler-combined"></i><span>Ölçekler</span></div>
                <div class="nav-item" data-module="feeSubjects"><i class="fas fa-tags"></i><span>Ücret Konuları</span></div>
                <div class="nav-item" data-module="feeSubSubjects"><i class="fas fa-layer-group"></i><span>Ücret Alt Konuları</span></div>
                <div class="nav-item" data-module="definitions"><i class="fas fa-file-invoice-dollar"></i><span>Tahakkuk Tanımları</span></div>
            </div>
        </div>

        <div class="main-content">
            <div class="top-bar">
                <h1 class="page-title" id="current-module-title">İl Yönetimi</h1>
                <div><i class="fas fa-database"></i> <span id="record-count">0 kayıt</span></div>
            </div>

            <div class="dual-pane">
                <div class="list-pane">
                    <div class="section-header">
                        <span><i class="fas fa-list-ul"></i> Kayıt Listesi</span>
                        <button id="refreshListBtn" type="button" style="background:#eef2ff; color:#2563eb;">
                            <i class="fas fa-sync-alt"></i> Yenile
                        </button>
                    </div>

                    <div id="listContainer">
                        <div class="empty-msg">Yükleniyor...</div>
                    </div>
                </div>

                <div class="form-pane">
                    <div class="section-header">
                        <span><i class="fas fa-pen-alt"></i> <span id="formTitle">Yeni Kayıt Ekle</span></span>
                        <button id="clearFormBtn" type="button" class="btn-secondary">
                            <i class="fas fa-eraser"></i> Temizle
                        </button>
                    </div>

                    <form id="dataForm">
                        <input type="hidden" id="editId" value="" />
                        <div id="dynamicFormFields"></div>

                        <div style="display:flex; gap:12px; margin-top:20px;">
                            <button type="submit" id="saveBtn"><i class="fas fa-save"></i> Kaydet</button>
                            <button type="button" id="deleteBtn" class="danger"><i class="fas fa-trash"></i> Sil</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


