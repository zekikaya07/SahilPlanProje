        districts: { name:"İlçeler", fields: ["city_id","code","district_no","name","is_central","is_active"], labels: {city_id:"İl",code:"İlçe Kodu",district_no:"No",name:"İlçe Adı",is_central:"Merkez",is_active:"Aktif"}, foreign:{city_id:{table:"cities",label:"name",value:"id"}} },
        tahakkukYears: { name:"Tahakkuk Yılları", fields: ["district_id","year","is_active"], labels: {district_id:"İlçe",year:"Yıl",is_active:"Aktif"}, foreign:{district_id:{table:"districts",label:"name",value:"id"}} },
        institutions: { name:"Kurumlar", fields: ["tahakkuk_year_id","name","is_active"], labels: {tahakkuk_year_id:"Tahakkuk Yılı",name:"Kurum Adı",is_active:"Aktif"}, foreign:{tahakkuk_year_id:{table:"tahakkukYears",label:"year",value:"id"}} },
        departments: { name:"Daire Başkanlıkları", fields: ["tahakkuk_institution_id","name","is_active"], labels: {tahakkuk_institution_id:"Kurum",name:"Daire Adı",is_active:"Aktif"}, foreign:{tahakkuk_institution_id:{table:"tahakkukInstitutions",label:"name",value:"id"}} },
        directorates: { name:"Müdürlükler", fields: ["tahakkuk_department_id","name","is_active"], labels: {tahakkuk_department_id:"Daire Başkanlığı",name:"Müdürlük Adı",is_active:"Aktif"}, foreign:{tahakkuk_department_id:{table:"tahakkukDepartments",label:"name",value:"id"}} },
        scales: { name:"Ölçekler", fields: ["tahakkuk_directorate_id","scale_value","name","is_active"], labels: {tahakkuk_directorate_id:"Müdürlük",scale_value:"Ölçek Değeri",name:"Ölçek Adı",is_active:"Aktif"}, foreign:{tahakkuk_directorate_id:{table:"tahakkukDirectories",label:"name",value:"id"}} },
        feeSubjects: { name:"Ücret Konuları", fields: ["tahakkuk_directorate_id","name","is_active"], labels: {tahakkuk_directorate_id:"Müdürlük",name:"Ücret Konusu",is_active:"Aktif"}, foreign:{tahakkuk_directorate_id:{table:"tahakkukDirectories",label:"name",value:"id"}} },
        definitions: { name:"Ücret Tanımları", fields: ["tahakkuk_fee_subject_id","fee_text","fee_amount","has_vat","description1","description2","is_active"], labels: {tahakkuk_fee_subject_id:"Ücret Konusu",fee_text:"Ücret Metni",fee_amount:"Tutar",has_vat:"KDV",description1:"Açıklama1",description2:"Açıklama2",is_active:"Aktif"}, foreign:{tahakkuk_fee_subject_id:{table:"tahakkukFeeSubjects",label:"name",value:"id"}} }
    };

    function getTableName(module) {
        const mapping = {
            cities:"cities", districts:"districts", tahakkukYears:"tahakkukYears",
            institutions:"tahakkukInstitutions", departments:"tahakkukDepartments",
            directorates:"tahakkukDirectories", scales:"tahakkukScales",
            feeSubjects:"tahakkukFeeSubjects", definitions:"tahakkukDefinitions"
        };
        return mapping[module];
    }

    function loadRecords() {
        const table = getTableName(currentModule);
        if(!table) return;
        currentRecords = [...db[table]];
        renderList();
        document.getElementById("record-count").innerText = currentRecords.length + " kayıt";
        document.getElementById("current-module-title").innerText = moduleSchemas[currentModule]?.name + " Yönetimi";
    }

    function renderList() {
        const container = document.getElementById("listContainer");
        const schema = moduleSchemas[currentModule];
        if(!schema){ container.innerHTML="<div class='empty-msg'>Hata</div>"; return; }
        if(currentRecords.length === 0){
            container.innerHTML="<div class='empty-msg'><i class='fas fa-database'></i> Kayıt yok</div>";
            return;
        }
        const displayFields = schema.fields.filter(f => f !== "is_active" && f !== "create_date");
        const tableHtml = `<table class="entity-table"><thead><tr>${displayFields.map(f=>`<th>${schema.labels[f] || f}</th>`).join('')}<th>Durum</th><th></th></tr></thead><tbody>
            ${currentRecords.map(rec => {
                const rowVals = displayFields.map(f => {
                    let val = rec[f];
                    if(schema.foreign && schema.foreign[f]){
                        const ref = schema.foreign[f];
                        const targetTable = db[ref.table];
                        const found = targetTable.find(t => t[ref.value] === val);
                        val = found ? found[ref.label] : val;
                    }
                    return `<td>${val ?? "-"}</td>`;
                }).join('');
                const activeBadge = rec.is_active ? "<span class='badge-active'>Aktif</span>" : "<span class='badge-active badge-inactive'>Pasif</span>";
                return `<tr class="record-row" data-id="${rec.id}">${rowVals}<td>${activeBadge}</td><td class="action-icons"><i class="fas fa-edit edit-icon" data-id="${rec.id}"></i> <i class="fas fa-trash-alt delete-icon" data-id="${rec.id}"></i></td></tr>`;
            }).join('')}
        </tbody></table>`;
        container.innerHTML = tableHtml;
        document.querySelectorAll('.edit-icon').forEach(icon => icon.addEventListener('click', (e) => { e.stopPropagation(); loadToForm(parseInt(icon.dataset.id)); }));
        document.querySelectorAll('.delete-icon').forEach(icon => icon.addEventListener('click', (e) => { e.stopPropagation(); if(confirm("Silinsin mi?")) deleteRecordById(parseInt(icon.dataset.id)); }));
        document.querySelectorAll('.record-row').forEach(row => row.addEventListener('click', (e) => { if(e.target.classList.contains('edit-icon')||e.target.classList.contains('delete-icon')) return; loadToForm(parseInt(row.dataset.id)); }));
    }

    function loadToForm(id){
        const table = getTableName(currentModule);
        const record = db[table].find(r => r.id === id);
        if(!record) return;
        document.getElementById("editId").value = id;
        document.getElementById("formTitle").innerText = "Kaydı Güncelle";
        generateFormFields(record);
    }

    function generateFormFields(existing = null){
        const schema = moduleSchemas[currentModule];
        const fieldsDiv = document.getElementById("dynamicFormFields");
        let html = "";
        for(let field of schema.fields){
            let value = existing ? existing[field] : (field === "is_active" ? true : (field === "has_vat"? false : ""));
            if(field === "create_date") continue;
            if(schema.foreign && schema.foreign[field]){
                const ref = schema.foreign[field];
                const options = db[ref.table] || [];
                html += `<div class="form-group"><label>${schema.labels[field]}</label><select name="${field}" id="field_${field}"><option value="">Seçiniz</option>`;
                options.forEach(opt => {
                    const selected = (value == opt[ref.value]) ? "selected" : "";
                    html += `<option value="${opt[ref.value]}" ${selected}>${opt[ref.label]}</option>`;
                });
                html += `</select></div>`;
            } else if(field === "is_active" || field === "has_vat"){
                const checked = value ? "checked" : "";
                html += `<div class="form-group"><label>${schema.labels[field]}</label><div><input type="checkbox" id="field_${field}" ${checked} /> Aktif/Pasif</div></div>`;
            } else {
                html += `<div class="form-group"><label>${schema.labels[field]}</label><input type="text" id="field_${field}" value="${value ?? ""}" /></div>`;
            }
        }
        fieldsDiv.innerHTML = html;
    }

    function clearForm(){
        document.getElementById("editId").value = "";
        document.getElementById("formTitle").innerText = "Yeni Kayıt Ekle";
        generateFormFields(null);
    }

    function getFormData(){
        const schema = moduleSchemas[currentModule];
        const data = {};
        for(let field of schema.fields){
            if(field === "create_date") continue;
            const el = document.getElementById(`field_${field}`);
            if(!el) continue;
            if(el.type === "checkbox") data[field] = el.checked;
            else if(el.tagName === "SELECT") data[field] = el.value ? (isNaN(parseInt(el.value))? el.value : parseInt(el.value)) : null;
            else data[field] = el.value;
        }
        data.is_active = data.is_active !== undefined ? data.is_active : true;
        if(data.fee_amount) data.fee_amount = parseFloat(data.fee_amount);
        return data;
    }

    function saveRecord(){
        const tableName = getTableName(currentModule);
        const editId = document.getElementById("editId").value;
        const formData = getFormData();
        const nowDate = new Date().toISOString().slice(0,10);
        if(editId){
            const idx = db[tableName].findIndex(r => r.id == editId);
            if(idx !== -1) db[tableName][idx] = { ...db[tableName][idx], ...formData };
        } else {
            const newId = db[tableName].length ? Math.max(...db[tableName].map(r=>r.id)) + 1 : 1;
            db[tableName].push({ id: newId, ...formData, create_date: nowDate });
        }
        loadRecords();
        clearForm();
    }

    function deleteRecordById(id){
        const tableName = getTableName(currentModule);
        const idx = db[tableName].findIndex(r=>r.id === id);
        if(idx !== -1) db[tableName].splice(idx,1);
        loadRecords();
        clearForm();
    }

    function switchModule(module){
        currentModule = module;
        loadRecords();
        clearForm();
    }

    // Event Listeners
    document.querySelectorAll(".nav-item").forEach(item => {
        item.addEventListener("click", () => {
            document.querySelectorAll(".nav-item").forEach(n=>n.classList.remove("active"));
            item.classList.add("active");
            switchModule(item.dataset.module);
        });
    });
    document.getElementById("refreshListBtn").addEventListener("click", ()=>loadRecords());
    document.getElementById("clearFormBtn").addEventListener("click", ()=>clearForm());
    document.getElementById("dataForm").addEventListener("submit", (e)=>{ e.preventDefault(); saveRecord(); });
    document.getElementById("deleteBtn").addEventListener("click", ()=>{
        const id = document.getElementById("editId").value;
        if(id && confirm("Kalıcı olarak sil?")) deleteRecordById(parseInt(id));
        else if(!id) alert("Silmek için listeden bir kayıt seçin.");
    });

    // Başlat
    switchModule("cities");
    document.querySelector('.nav-item[data-module="cities"]').classList.add("active");
</script> *@