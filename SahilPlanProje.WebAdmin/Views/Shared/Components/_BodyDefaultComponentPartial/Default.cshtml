    function buildUrl(url, id = null) {
        let result = API_BASE_URL + url;
        if (id !== null) {
            result = result.replace("{id}", id);
        }
        return result;
    }

async function apiRequest(url, method = "GET", data = null) {
    const options = {
        method: method
    };

    if (data !== null) {
        options.headers = {
            "Content-Type": "application/json"
        };
        options.body = JSON.stringify(data);
    }

    const response = await fetch(url, options);

    if (!response.ok) {
        const errorText = await response.text();
        throw new Error(errorText || "API isteği başarısız oldu.");
    }

    const text = await response.text();

    if (!text) {
        return null;
    }

    try {
        return JSON.parse(text);
    } catch {
        return text;
    }
}
    async function loadRecords() {

        const config = apiConfig[currentModule];

        try {

            await loadLookups(config);

            const url = buildUrl(config.listUrl);

            const result = await apiRequest(url);

            currentRecords = Array.isArray(result)
                ? result
                : (result?.data || []);

            renderList();

        } catch (error) {

            console.error(error);
        }
    }

        async function loadLookups(config) {
        lookupData = {};

        if (!config.lookups) return;

        for (const field in config.lookups) {
            const lookup = config.lookups[field];
            const result = await apiRequest(buildUrl(lookup.url));

            lookupData[field] = Array.isArray(result)
                ? result
                : (result?.data || []);
        }
    }

        function renderList() {
