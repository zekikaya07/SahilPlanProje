    async function loadToForm(id) {
        const config = apiConfig[currentModule];

        try {
            const url = buildUrl(config.getUrl, id);
            const record = await apiRequest(url);

            document.getElementById("editId").value = record.id;
            document.getElementById("formTitle").innerText = "Kaydı Güncelle";

            generateFormFields(record);
        } catch (error) {
            alert("Kayıt getirme hatası: " + error.message);
        }
    }

    function generateFormFields(record = null) {
        const config = apiConfig[currentModule];
        const fieldsDiv = document.getElementById("dynamicFormFields");

        let html = "";

        config.fields.forEach(field => {
            const label = config.labels[field] || field;
            const value = record ? record[field] : "";

            if (field === "is_active" || field === "has_vat" || field === "is_central") {
                const checked = record ? (record[field] ? "checked" : "") : "checked";

                html += `
                    <div class="form-group">
                        <label>${label}</label>
                        <input type="checkbox" id="field_${field}" ${checked}>
                    </div>
                `;
            }
                else if (config.lookups && config.lookups[field]) {
        const options = lookupData[field] || [];

        html += `
            <div class="form-group">
                <label>${label}</label>
                <select id="field_${field}">
                    <option value="">Seçiniz</option>
                    ${options.map(opt => `
                        <option value="${opt.id}" ${Number(value) === Number(opt.id) ? "selected" : ""}>
                            ${opt.name}
                        </option>
                    `).join("")}
                </select>
            </div>
        `;
    }
    else if (field.includes("_id")) {
        html += `
            <div class="form-group">
                <label>${label}</label>
                <input type="number" id="field_${field}" value="${value ?? ""}">
            </div>
        `;
    }
            else if (field === "fee_amount") {
                html += `
                    <div class="form-group">
                        <label>${label}</label>
                        <input type="number" step="0.01" id="field_${field}" value="${value ?? ""}">
                    </div>
                `;
            }
            else if (field === "description1" || field === "description2") {
                html += `
                    <div class="form-group">
                        <label>${label}</label>
                        <textarea id="field_${field}">${value ?? ""}</textarea>
                    </div>
                `;
                } 
                
    //             else if (field === "plate_code") {

    //     html += `
    //         <div class="form-group">
    //             <label>${label}</label>

    //             <input
    //                 type="number"
    //                 id="field_${field}"
