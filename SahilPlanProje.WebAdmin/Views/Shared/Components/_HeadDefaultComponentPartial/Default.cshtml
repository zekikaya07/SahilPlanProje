<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tahakkuk Yönetim Paneli | Tam Hiyerarşi (Ölçek Dahil)</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f1f5f9;
            color: #0f172a;
        }

        .app-container {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */
        .sidebar {
            width: 290px;
            background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
            color: #e2e8f0;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            box-shadow: 4px 0 20px rgba(0,0,0,0.08);
        }

        .sidebar-header {
            padding: 28px 24px;
            border-bottom: 1px solid #334155;
        }

            .sidebar-header h2 {
                font-size: 1.4rem;
                display: flex;
                align-items: center;
                gap: 10px;
                color: white;
            }

                .sidebar-header h2 i {
                    color: #38bdf8;
                    font-size: 1.6rem;
                }

        .nav-menu {
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            border-radius: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.2s;
            color: #cbd5e1;
            font-size: 0.9rem;
        }

            .nav-item i {
                width: 24px;
            }

            .nav-item:hover {
                background: #334155;
                color: white;
            }

            .nav-item.active {
                background: #3b82f6;
                color: white;
            }

        /* MAIN */
        .main-content {
            flex: 1;
            background: #f8fafc;
            display: flex;
            flex-direction: column;
        }

        .top-bar {
            background: white;
            padding: 16px 28px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #1e293b, #2d3a4e);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        /* DUAL PANE: Liste ve Form farklı arka plan */
        .dual-pane {
            display: flex;
            gap: 28px;
            padding: 28px 32px;
            flex-wrap: wrap;
            flex: 1;
        }

        .list-pane {
            flex: 1.3;
            background: white;
            border-radius: 28px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.03);
            padding: 22px;
            border: 1px solid #eef2f6;
        }

        .form-pane {
            flex: 1;
            background: linear-gradient(135deg, #fffef8, #fff7ed);
            border-radius: 28px;
            box-shadow: 0 20px 30px -12px rgba(0,0,0,0.1);
            padding: 24px;
            border: 1px solid #ffe6c7;
        }

        .section-header {
            font-weight: 700;
            font-size: 1.1rem;
            border-left: 5px solid #3b82f6;
            padding-left: 14px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
        }

        .entity-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.8rem;
        }

            .entity-table th, .entity-table td {
                padding: 10px 6px;
                border-bottom: 1px solid #eef2f8;
                text-align: left;
            }

            .entity-table th {
                color: #475569;
                font-weight: 600;
            }

        .record-row {
            cursor: pointer;
            transition: 0.05s;
        }

            .record-row:hover {
                background: #f8fafc;
            }

        .badge-active {
            background: #dcfce7;
            color: #15803d;
            padding: 3px 10px;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .badge-inactive {
            background: #fee2e2;
            color: #b91c1c;
        }

        .form-group {
            margin-bottom: 18px;
        }

        label {
            font-weight: 600;
            font-size: 0.75rem;
            display: block;
            margin-bottom: 5px;
            color: #334155;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        input, select, textarea {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 16px;
            font-family: 'Inter', monospace;
            font-size: 0.85rem;
            background: white;
        }

            input:focus, select:focus {
                outline: none;
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59,130,246,0.2);
            }

        button {
            background: #3b82f6;
            border: none;
            padding: 10px 20px;
            border-radius: 40px;
            font-weight: 600;
            color: white;
            cursor: pointer;
            font-size: 0.8rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            button.btn-secondary {
                background: #e2e8f0;
                color: #1e293b;
            }

            button.danger {
                background: #ef4444;
            }

        .action-icons i {
            margin: 0 5px;
            cursor: pointer;
            font-size: 0.9rem;
        }

        .empty-msg {
            text-align: center;
            padding: 40px;
            color: #94a3b8;
        }

        <style >
        hr {
            margin: 12px 0;
        }

        @@media (max-width: 800px) {

            .dual-pane {
                flex-direction: column;
            }

            .sidebar {
                width: 80px;
            }

            .nav-item span {
                display: none;
            }

            .nav-item i {
                margin: auto;
            }
        }
    </style>
</head>
