@using System.Collections.Generic
@using Newtonsoft.Json
@model SahilPlanProje.WebUI.Dtos.TahakkukFilterOptionsDto

<div id="tahakkuk-hesaplama" class="section wb tahakkuk-section">
    <div class="container">
        <div class="col-lg-12">
            <div class="customwidget text-center">
                <div class="checkdomain-wrapper tahakkuk-wrapper">

                    <h2>Tahakkuk Hesaplama Sistemi</h2>

                    <p>İl, ilçe, yıl, kurum, müdürlük, ölçek ve ücret bilgilerini seçerek tahakkuk hesaplayabilirsiniz.</p>

                    <br />

                    <div class="row">

                        <div class="col-md-4 mb-3">
                            <select id="citySelect" class="form-control">
                                <option value="">İl Seçiniz</option>
                                @if (Model?.cities != null)
                                {
                                    foreach (var item in Model.cities)
                                    {
                                        <option value="@item.id">@item.name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <select id="districtSelect" class="form-control">
                                <option value="">İlçe Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <select id="yearSelect" class="form-control">
                                <option value="">Yıl Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <select id="institutionSelect" class="form-control">
                                <option value="">Kurum Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <select id="departmentSelect" class="form-control">
                                <option value="">Daire Başkanlığı Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <select id="directorateSelect" class="form-control">
                                <option value="">Müdürlük Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <select id="scaleSelect" class="form-control">
                                <option value="">Ölçek Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <select id="feeSubjectSelect" class="form-control">
                                <option value="">Ücret Konusu Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <select id="feeSubSubjectSelect" class="form-control">
                                <option value="">Ücret Alt Konusu Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <input id="unitMultiplierInput"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   value="1"
                                   class="form-control"
                                   placeholder="Birim Çarpan" />
                        </div>

                    </div>

                    <br />

                    <a href="javascript:void(0)"
                       onclick="calculateTahakkuk()"
                       class="hover-btn-new tahakkuk-btn">
                        <span>Hesapla</span>
                    </a>

                    <div id="hesaplamaSonuc" style="display:none; margin-top:25px; text-align:left;">
                        <h3>Tahakkuk Sonucu</h3>

                        <p><strong>İl:</strong> <span id="sonucIl"></span></p>
                        <p><strong>İlçe:</strong> <span id="sonucIlce"></span></p>
                        <p><strong>Yıl:</strong> <span id="sonucYil"></span></p>
                        <p><strong>Kurum:</strong> <span id="sonucKurum"></span></p>
                        <p><strong>Daire Başkanlığı:</strong> <span id="sonucDaire"></span></p>
                        <p><strong>Müdürlük:</strong> <span id="sonucMudurluk"></span></p>
                        <p><strong>Ölçek:</strong> <span id="sonucOlcek"></span></p>
                        <p><strong>Ücret Konusu:</strong> <span id="sonucUcretKonusu"></span></p>
                        <p><strong>Ücret Alt Konusu:</strong> <span id="sonucUcretAltKonusu"></span></p>

                        <hr />

                        <p><strong>Tarife Metni:</strong> <span id="sonucFiyatText"></span></p>
                        <p><strong>Birim Ücret:</strong> <span id="sonucBirimUcret"></span></p>
                        <p><strong>Birim Çarpan:</strong> <span id="sonucBirimCarpan"></span></p>
                        <p><strong>KDV Durumu:</strong> <span id="sonucKdv"></span></p>
                        <p><strong>Toplam Ücret:</strong> <span id="sonucToplam"></span></p>

                        <p><strong>Açıklama 1:</strong> <span id="sonucAciklama1"></span></p>
                        <p><strong>Açıklama 2:</strong> <span id="sonucAciklama2"></span></p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const API_BASE_URL = "https://api.sahilplanproje.com/api";

    const districts = @Html.Raw(JsonConvert.SerializeObject(Model?.districts ?? new List<SahilPlanProje.WebUI.Dtos.DistrictOptionDto>()));
    const years = @Html.Raw(JsonConvert.SerializeObject(Model?.years ?? new List<SahilPlanProje.WebUI.Dtos.YearOptionDto>()));
    const institutions = @Html.Raw(JsonConvert.SerializeObject(Model?.institutions ?? new List<SahilPlanProje.WebUI.Dtos.InstitutionOptionDto>()));
    const departments = @Html.Raw(JsonConvert.SerializeObject(Model?.departments ?? new List<SahilPlanProje.WebUI.Dtos.DepartmentOptionDto>()));
    const directorates = @Html.Raw(JsonConvert.SerializeObject(Model?.directorates ?? new List<SahilPlanProje.WebUI.Dtos.DirectorateOptionDto>()));
    const scales = @Html.Raw(JsonConvert.SerializeObject(Model?.scales ?? new List<SahilPlanProje.WebUI.Dtos.ScaleOptionDto>()));
    const feeSubjects = @Html.Raw(JsonConvert.SerializeObject(Model?.fee_subjects ?? new List<SahilPlanProje.WebUI.Dtos.FeeSubjectOptionDto>()));
    const feeSubSubjects = @Html.Raw(JsonConvert.SerializeObject(Model?.fee_sub_subjects ?? new List<SahilPlanProje.WebUI.Dtos.FeeSubSubjectOptionDto>()));

    let selectedDefinition = null;

    const citySelect = document.getElementById("citySelect");
    const districtSelect = document.getElementById("districtSelect");
    const yearSelect = document.getElementById("yearSelect");
    const institutionSelect = document.getElementById("institutionSelect");
    const departmentSelect = document.getElementById("departmentSelect");
    const directorateSelect = document.getElementById("directorateSelect");
    const scaleSelect = document.getElementById("scaleSelect");
    const feeSubjectSelect = document.getElementById("feeSubjectSelect");
    const feeSubSubjectSelect = document.getElementById("feeSubSubjectSelect");
    const unitMultiplierInput = document.getElementById("unitMultiplierInput");

    function fillSelect(select, data, defaultText, textField = "name") {
        select.innerHTML = `<option value="">${defaultText}</option>`;

        data.forEach(item => {
            const option = document.createElement("option");
            option.value = item.id;
            option.textContent = item[textField] ?? item.name ?? item.year;
            select.appendChild(option);
        });
    }

    function getSelectedText(select) {
        if (!select || select.selectedIndex < 0) return "";
        return select.options[select.selectedIndex].text;
    }

    function resetResult() {
        selectedDefinition = null;
        document.getElementById("hesaplamaSonuc").style.display = "none";
    }

    function clearSelects(selects) {
        selects.forEach(x => fillSelect(x.select, [], x.text));
    }

    citySelect.addEventListener("change", function () {
        resetResult();

        const cityId = parseInt(this.value);

        fillSelect(
            districtSelect,
            districts.filter(x => x.city_id === cityId),
            "İlçe Seçiniz"
        );    
        
        // İl seçilince yıl ve kurum hemen dolsun
        fillSelect(
            yearSelect,
            years,
            "Yıl Seçiniz",
            "year"
        );

        fillSelect(
            institutionSelect,
            institutions,
            "Kurum Seçiniz"
        );

        clearSelects([
            // { select: yearSelect, text: "Yıl Seçiniz" },
            // { select: institutionSelect, text: "Kurum Seçiniz" },
            { select: departmentSelect, text: "Daire Başkanlığı Seçiniz" },
            { select: directorateSelect, text: "Müdürlük Seçiniz" },
            { select: scaleSelect, text: "Ölçek Seçiniz" },
            { select: feeSubjectSelect, text: "Ücret Konusu Seçiniz" },
            { select: feeSubSubjectSelect, text: "Ücret Alt Konusu Seçiniz" }
        ]);
    });

    districtSelect.addEventListener("change", function () {
        resetResult();

        fillSelect(
            yearSelect,
            years,
            "Yıl Seçiniz",
            "year"
        );

        fillSelect(
            institutionSelect,
            institutions,
            "Kurum Seçiniz"
        );

        // clearSelects([
        //     { select: departmentSelect, text: "Daire Başkanlığı Seçiniz" },
        //     { select: directorateSelect, text: "Müdürlük Seçiniz" },
        //     { select: scaleSelect, text: "Ölçek Seçiniz" },
        //     { select: feeSubjectSelect, text: "Ücret Konusu Seçiniz" },
        //     { select: feeSubSubjectSelect, text: "Ücret Alt Konusu Seçiniz" }
        // ]);
    });
    function getInstitutionId(x) {
        return Number(x.tahakkuk_institution_id ?? x.tahakkukInstitutionId);
    }

    function getDepartmentId(x) {
        return x.tahakkuk_department_id ?? x.tahakkukDepartmentId ?? null;
    }

    institutionSelect.addEventListener("change", function () {
        resetResult();

        const institutionId = Number(this.value);

        fillSelect(
            departmentSelect,
            departments.filter(x => Number(x.tahakkuk_institution_id ?? x.tahakkukInstitutionId) === institutionId),
            "Daire Başkanlığı Seçiniz"
        );

        fillSelect(
            directorateSelect,
            directorates.filter(x => getInstitutionId(x) === institutionId),
            "Müdürlük Seçiniz"
        );

        fillSelect(scaleSelect, scales, "Ölçek Seçiniz");

        clearSelects([
            { select: feeSubjectSelect, text: "Ücret Konusu Seçiniz" },
            { select: feeSubSubjectSelect, text: "Ücret Alt Konusu Seçiniz" }
        ]);
    });

    departmentSelect.addEventListener("change", function () {
        resetResult();

        const institutionId = Number(institutionSelect.value);
        const departmentId = Number(this.value);

        let filteredDirectorates = directorates.filter(x =>
            getInstitutionId(x) === institutionId
        );

        if (departmentId) {
            filteredDirectorates = filteredDirectorates.filter(x =>
                Number(getDepartmentId(x)) === departmentId ||
                getDepartmentId(x) === null
            );
        }

        fillSelect(
            directorateSelect,
            filteredDirectorates,
            "Müdürlük Seçiniz"
        );
    });

    directorateSelect.addEventListener("change", function () {
        resetResult();

        fillSelect(scaleSelect, scales, "Ölçek Seçiniz");

        clearSelects([
            { select: feeSubjectSelect, text: "Ücret Konusu Seçiniz" },
            { select: feeSubSubjectSelect, text: "Ücret Alt Konusu Seçiniz" }
        ]);
    });

    scaleSelect.addEventListener("change", function () {

        resetResult();

        fillSelect(
            feeSubjectSelect,
            feeSubjects,
            "Ücret Konusu Seçiniz"
        );

        fillSelect(
            feeSubSubjectSelect,
            [],
            "Ücret Alt Konusu Seçiniz"
        );
    });
    feeSubjectSelect.addEventListener("change", function () {

        resetResult();

        const feeSubjectId = parseInt(this.value);

        fillSelect(
            feeSubSubjectSelect,
            feeSubSubjects.filter(x =>
                x.tahakkuk_fee_subject_id === feeSubjectId
            ),
            "Ücret Alt Konusu Seçiniz"
        );
    });

    feeSubSubjectSelect.addEventListener("change", async function () {
        selectedDefinition = null;

        const cityId = parseInt(citySelect.value);
        const districtId = parseInt(districtSelect.value);
        const yearId = parseInt(yearSelect.value);
        const institutionId = parseInt(institutionSelect.value);
        const departmentId = parseInt(departmentSelect.value);
        const directorateId = parseInt(directorateSelect.value);
        const scaleId = parseInt(scaleSelect.value);
        const feeSubjectId = parseInt(feeSubjectSelect.value);
        const feeSubSubjectId = parseInt(this.value);

        if (!feeSubjectId || !feeSubSubjectId) {
            return;
        }

        try {
            let url =
                `${API_BASE_URL}/Tahakkuk/definition` +
                `?feeSubjectId=${feeSubjectId}` +
                `&feeSubSubjectId=${feeSubSubjectId}`;

            if (cityId) url += `&cityId=${cityId}`;
            if (districtId) url += `&districtId=${districtId}`;
            if (yearId) url += `&yearId=${yearId}`;
            if (institutionId) url += `&institutionId=${institutionId}`;
            if (departmentId) url += `&departmentId=${departmentId}`;
            if (directorateId) url += `&directorateId=${directorateId}`;
            if (scaleId) url += `&scaleId=${scaleId}`;

            const response = await fetch(url);

            if (!response.ok) {
                console.error("Definition API hatası:", response.status);
                return;
            }

            selectedDefinition = await response.json();
            console.log("Definition:", selectedDefinition);

        } catch (err) {
            console.error("Definition fetch hatası:", err);
        }
    });

    function formatMoney(value) {
        return Number(value || 0).toLocaleString("tr-TR", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        }) + " ₺";
    }
    function getNumberValue(select) {
        const value = Number(select.value);
        return Number.isFinite(value) && value > 0 ? value : null;
    }
    async function calculateTahakkuk() {

        const cityId = getNumberValue(citySelect);
        const districtId = getNumberValue(districtSelect);
        const yearId = getNumberValue(yearSelect);
        const institutionId = getNumberValue(institutionSelect);
        const departmentId = getNumberValue(departmentSelect);
        const directorateId = getNumberValue(directorateSelect);
        const scaleId = getNumberValue(scaleSelect);
        const feeSubjectId = getNumberValue(feeSubjectSelect);
        const feeSubSubjectId = getNumberValue(feeSubSubjectSelect);

        if (!cityId ||  !institutionId || !directorateId || !scaleId || !feeSubjectId) {
            alert("Lütfen zorunlu seçimleri tamamlayınız.");
            return;
        }

        let url =
            `${API_BASE_URL}/Tahakkuk/definition` +
            `?cityId=${cityId}` +
            `&institutionId=${institutionId}` +
            `&directorateId=${directorateId}` +
            `&scaleId=${scaleId}` +
            `&feeSubjectId=${feeSubjectId}`;
            
        if (districtId) url += `&districtId=${districtId}`;
        if (yearId) url += `&yearId=${yearId}`;
        if (departmentId) url += `&departmentId=${departmentId}`;
        if (feeSubSubjectId) url += `&feeSubSubjectId=${feeSubSubjectId}`;

        const response = await fetch(url);

        if (!response.ok) {
            alert("Seçimlere uygun tahakkuk tanımı bulunamadı.");
            return;
        }

        selectedDefinition = await response.json();

        let multiplier = parseFloat(unitMultiplierInput.value.replace(",", "."));

        if (isNaN(multiplier) || multiplier <= 0) {
            multiplier = 1;
            unitMultiplierInput.value = "1";
        }

        const unitPrice = Number(selectedDefinition.price || 0);

        let calculatedPrice = unitPrice * multiplier;

        if (selectedDefinition.has_vat) {
            calculatedPrice = calculatedPrice * 1.20;
        }

        document.getElementById("sonucIl").innerText = getSelectedText(citySelect);
        document.getElementById("sonucIlce").innerText = getSelectedText(districtSelect);
        document.getElementById("sonucYil").innerText = getSelectedText(yearSelect);
        document.getElementById("sonucKurum").innerText = getSelectedText(institutionSelect);
        document.getElementById("sonucDaire").innerText = getSelectedText(departmentSelect);
        document.getElementById("sonucMudurluk").innerText = getSelectedText(directorateSelect);
        document.getElementById("sonucOlcek").innerText = getSelectedText(scaleSelect);
        document.getElementById("sonucUcretKonusu").innerText = getSelectedText(feeSubjectSelect);
        document.getElementById("sonucUcretAltKonusu").innerText = getSelectedText(feeSubSubjectSelect);

        document.getElementById("sonucFiyatText").innerText = selectedDefinition.description ?? "";
        document.getElementById("sonucBirimUcret").innerText = formatMoney(unitPrice);
        document.getElementById("sonucBirimCarpan").innerText = multiplier;
        document.getElementById("sonucKdv").innerText = selectedDefinition.has_vat ? "KDV Dahil / Uygulanır" : "KDV Yok";
        document.getElementById("sonucToplam").innerText = formatMoney(calculatedPrice);

        document.getElementById("sonucAciklama1").innerText = selectedDefinition.description ?? "";
        document.getElementById("sonucAciklama2").innerText = selectedDefinition.description2 ?? "";

        document.getElementById("hesaplamaSonuc").style.display = "block";
    }
</script>